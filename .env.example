# Optional. Copy to server/.env. Never put credentials in web/ or VITE_* variables.
PORT=3001
WEB_PORT=5184
# All credentials stay on the server. No key is required for local replies.
# auto uses OpenAI when a key is present; local/browser forces the free paths.
LLM_PROVIDER=auto
TTS_PROVIDER=auto
OPENAI_API_KEY=
# Optional per-service key overrides:
LLM_API_KEY=
TTS_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=2000
# Speech API is currently supported but retires January 6, 2027; see README.
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE_ID=onyx
TTS_TIMEOUT_MS=15000
